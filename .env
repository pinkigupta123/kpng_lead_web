# Dev: requests go to /api and Vite proxies them to the backend below (no CORS needed).

# Leave VITE_API_URL unset: the app calls /api, which Vite proxies in dev and vercel.json rewrites in production.
# VITE_API_URL=http://103.218.127.27:8080/index.php/api

# ---- LOCAL backend (php artisan serve --port=8000) ----
# VITE_PROXY_TARGET=http://127.0.0.1:8000
# VITE_PROXY_PREFIX=

# ---- LIVE server (uncomment these two and comment the local ones above) ----
VITE_PROXY_TARGET=http://103.218.127.27:8080
VITE_PROXY_PREFIX=/index.php
