# With VITE_API_URL set, the app calls the backend directly and the VITE_PROXY_* settings below are not used.
# For an HTTPS deploy (Vercel), leave it unset so the app calls /api and vercel.json rewrites it.
VITE_API_URL=http://103.218.127.27:8080/index.php/api

# ---- LOCAL backend (php artisan serve --port=8000) ----
# VITE_PROXY_TARGET=http://127.0.0.1:8000
# VITE_PROXY_PREFIX=

# ---- LIVE server (comment these two and uncomment the local ones above to go back) ----
VITE_PROXY_TARGET=http://103.218.127.27:8080
VITE_PROXY_PREFIX=/index.php
