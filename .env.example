# Dev: requests go to /api and Vite proxies them to this backend (no CORS needed).
VITE_PROXY_TARGET=http://127.0.0.1:8000
# "/index.php" for the live server, empty for a local `php artisan serve`
VITE_PROXY_PREFIX=
# Production build: set the full backend URL (backend must allow CORS for your web origin).
# VITE_API_URL=https://your-backend/index.php/api
